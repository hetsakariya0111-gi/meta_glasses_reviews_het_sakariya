{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && npm install",
    "nixpacksPlan": {
      "providers": {
        "node": {
          "version": "20"
        }
      }
    }
  },
  "deploy": {
    "startCommand": "cd backend && npm start",
    "healthcheckPath": "/api/v1/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
