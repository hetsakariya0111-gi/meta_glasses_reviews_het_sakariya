{
	"info": {
		"_postman_id": "meta-glasses-reviews-api",
		"name": "Meta Glasses Reviews API",
		"description": "Complete API for Meta Glasses reviews platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "123456"
	},
	"item": [
		{
			"name": "Health Check",
			"item": [
				{
					"name": "Get Health Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						}
					}
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"name\": \"Test User\", \"email\": \"test@example.com\", \"password\": \"password123\"}"
						},
						"url": {"raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"]}
					}
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"email\": \"test@example.com\", \"password\": \"password123\"}"
						},
						"url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
					}
				},
				{
					"name": "Get Current User (Me)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"]}
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"]}
					}
				},
				{
					"name": "Update Profile",
					"request": {
						"method": "PUT",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
						"body": {"mode": "raw", "raw": "{\"name\": \"Updated Name\", \"email\": \"updated@example.com\"}"},
						"url": {"raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"]}
					}
				},
				{
					"name": "Get All Users",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/auth/users", "host": ["{{baseUrl}}"], "path": ["auth", "users"]}
					}
				},
				{
					"name": "Get User Reviews",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/auth/users/:name/reviews", "host": ["{{baseUrl}}"], "path": ["auth", "users", ":name", "reviews"], "variable": [{"key": "name", "value": "Test User"}]}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "GET",
						"url": {"raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"]}
					}
				}
			]
		},
		{
			"name": "Reviews",
			"item": [
				{
					"name": "Get All Reviews",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/reviews?page=1&limit=10&sort=-createdAt",
							"host": ["{{baseUrl}}"],
							"path": ["reviews"],
							"query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "10"}, {"key": "sort", "value": "-createdAt"}]
						}
					}
				},
				{
					"name": "Get Single Review",
					"request": {
						"method": "GET",
						"url": {"raw": "{{baseUrl}}/reviews/:id", "host": ["{{baseUrl}}"], "path": ["reviews", ":id"], "variable": [{"key": "id", "value": "review-id-here"}]}
					}
				},
				{
					"name": "Create Review",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
						"body": {
							"mode": "raw",
							"raw": "{\"title\": \"Great glasses!\", \"review\": \"Love the AR features!\", \"name\": \"Test User\", \"rating\": \"5\", \"country\": \"USA\", \"verifiedPurchase\": \"true\", \"helpful\": \"0\"}"
						},
						"url": {"raw": "{{baseUrl}}/reviews", "host": ["{{baseUrl}}"], "path": ["reviews"]}
					}
				},
				{
					"name": "Update Review",
					"request": {
						"method": "PUT",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
						"body": {"mode": "raw", "raw": "{\"title\": \"Updated Title\", \"review\": \"Updated review text\"}"},
						"url": {"raw": "{{baseUrl}}/reviews/:id", "host": ["{{baseUrl}}"], "path": ["reviews", ":id"], "variable": [{"key": "id", "value": "review-id-here"}]}
					}
				},
				{
					"name": "Delete Review",
					"request": {
						"method": "DELETE",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/reviews/:id", "host": ["{{baseUrl}}"], "path": ["reviews", ":id"], "variable": [{"key": "id", "value": "review-id-here"}]}
					}
				},
				{
					"name": "Get Analytics",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": {"raw": "{{baseUrl}}/reviews/analytics", "host": ["{{baseUrl}}"], "path": ["reviews", "analytics"]}
					}
				}
			]
		},
		{
			"name": "Stats",
			"item": [
				{
					"name": "Average Rating",
					"request": {"method": "GET", "url": {"raw": "{{baseUrl}}/stats/average-rating", "host": ["{{baseUrl}}"], "path": ["stats", "average-rating"]}}
				},
				{
					"name": "Positive Reviews",
					"request": {"method": "GET", "url": {"raw": "{{baseUrl}}/stats/positive-reviews", "host": ["{{baseUrl}}"], "path": ["stats", "positive-reviews"]}}
				},
				{
					"name": "Top Reviewers",
					"request": {"method": "GET", "url": {"raw": "{{baseUrl}}/stats/top-reviewers", "host": ["{{baseUrl}}"], "path": ["stats", "top-reviewers"]}}
				},
				{
					"name": "Most Helpful",
					"request": {"method": "GET", "url": {"raw": "{{baseUrl}}/stats/most-helpful", "host": ["{{baseUrl}}"], "path": ["stats", "most-helpful"]}}
				},
				{
					"name": "Verified Purchases",
					"request": {"method": "GET", "url": {"raw": "{{baseUrl}}/stats/verified-purchases", "host": ["{{baseUrl}}"], "path": ["stats", "verified-purchases"]}}
				},
				{
					"name": "Monthly Average",
					"request": {"method": "GET", "url": {"raw": "{{baseUrl}}/stats/monthly-average", "host": ["{{baseUrl}}"], "path": ["stats", "monthly-average"]}}
				}
			]
		},
		{
			"name": "Search",
			"item": [
				{
					"name": "Search Reviews (Root)",
					"request": {"method": "GET", "url": {"raw": "{{baseUrl}}/search?keyword=glasses", "host": ["{{baseUrl}}"], "path": ["search"], "query": [{"key": "keyword", "value": "glasses"}]}}
				},
				{
					"name": "Search Reviews (Reviews Path)",
					"request": {"method": "GET", "url": {"raw": "{{baseUrl}}/search/reviews?keyword=great", "host": ["{{baseUrl}}"], "path": ["search", "reviews"], "query": [{"key": "keyword", "value": "great"}]}}
				}
			]
		}
	],
	"variable": [
		{"key": "baseUrl", "value": "https://meta-glasses-reviews-het-sakariya-2.onrender.com/api/v1", "type": "string"},
		{"key": "token", "value": "", "type": "string"}
	]
}
